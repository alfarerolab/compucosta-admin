# =============================================================================
#  Compucosta Admin — Variables de entorno
# =============================================================================
#  1. Copia este archivo:      cp .env.example .env
#  2. Rellena los valores [OBLIGATORIA] (nunca subas el .env al repositorio).
#  3. Verifica la configuración:  npm run check:env
#
#  Leyenda:  [OBLIGATORIA]  la app o un proceso no funciona sin ella
#            [RECOMENDADA]  funciona sin ella, pero con limitaciones
#            [OPCIONAL]     tiene un valor por defecto razonable (indicado)
#
#  Generar un secreto seguro:
#    node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================


# -----------------------------------------------------------------------------
#  App
# -----------------------------------------------------------------------------
# development | production. En producción activa HSTS, cookies Secure y oculta logs.
NODE_ENV=development

# [OPCIONAL] Puerto del servidor Next (por defecto 3000)
PORT=3000

# [RECOMENDADA] URL pública del panel. La usan los procesos internos (cron, servicios)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
#  Base de datos (MySQL / Prisma)
# -----------------------------------------------------------------------------
# [OBLIGATORIA] mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
#  Si la contraseña tiene caracteres especiales (@ : / #), codifícalos en URL (%40, %3A...)
DATABASE_URL=mysql://compucosta:CAMBIAR@localhost:3306/compucosta_bd


# -----------------------------------------------------------------------------
#  Seguridad / sesión
# -----------------------------------------------------------------------------
# [OBLIGATORIA] Firma de las sesiones del panel (JWT HS256). Mínimo 32 caracteres aleatorios.
#  Debe ser LA MISMA en la app y en el servidor de sockets (socket-server.js).
#  Cambiarla cierra todas las sesiones activas.
JWT_SECRET=

# [OBLIGATORIA en producción] Token para POST /api/cron/erp-sync
#  (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# [OPCIONAL] Intentos de login permitidos por IP cada 10 minutos (por defecto 20)
LOGIN_RL_MAX=20

# [OPCIONAL] true para ver los logs detallados del middleware en producción
MIDDLEWARE_DEBUG=false


# -----------------------------------------------------------------------------
#  Rate limiting general (proxy.ts) — valores por defecto adecuados
# -----------------------------------------------------------------------------
# [OPCIONAL] Backend del limitador. Solo "memory" está implementado (por proceso).
RATE_LIMIT_BACKEND=memory
# [OPCIONAL] Peticiones /api permitidas por ventana, en total y por IP
RATE_LIMIT_GLOBAL_WINDOW_MS=1000
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_PER_IP_WINDOW_MS=1000
RATE_LIMIT_PER_IP_MAX=40
# [OPCIONAL] Cupo para los webhooks de Shopify (por ventana)
RATE_LIMIT_WEBHOOK_GLOBAL_MAX=120
RATE_LIMIT_WEBHOOK_PER_IP_MAX=30
# [OPCIONAL] Ajustes internos del limitador
RATE_LIMIT_BUCKET_MS=250
RATE_LIMIT_MAX_TRACKED_IPS=10000
# [OPCIONAL] Límite a sondeos de Server Actions sin sesión
PROBE_RL_WINDOW_MS=60000
PROBE_RL_MAX_HITS=12


# -----------------------------------------------------------------------------
#  Servidor de chat en tiempo real (socket-server.js, proceso PM2 aparte)
# -----------------------------------------------------------------------------
# [OPCIONAL] Puerto del servidor de sockets (por defecto 3001)
SOCKET_PORT=3001
#  Recuerda: el .env que lea este proceso también necesita JWT_SECRET.


# -----------------------------------------------------------------------------
#  ERP (DSNube) — catálogo, inventario y facturación electrónica
# -----------------------------------------------------------------------------
# [OBLIGATORIA] Credenciales del API del ERP
EXTERNAL_API_USERNAME=
EXTERNAL_API_PASSWORD=

# [OBLIGATORIA] Endpoints del ERP
#  (ej. https://ws.dsnube.co/api/v1 — sin valor por defecto)
EXTERNAL_API_URL_BASE=
EXTERNAL_API_URL_MARCAS=
EXTERNAL_API_URL_CATEGORIAS=

# [OPCIONAL] Endpoint de facturación (por defecto https://ws.dsnube.co/api/v1)
ERP_API_URL=https://ws.dsnube.co/api/v1

# [OBLIGATORIA en producción] Datos de facturación electrónica
#  Prefijo de la resolución de facturación (por defecto FEF)
ERP_PREFIJO_FACTURA=FEF
#  NIT del emisor, sin dígito de verificación (por defecto 800253616)
ERP_EMISOR=800253616
#  Sucursal y bodega del ERP (por defecto 1)
ERP_IDSUC=1
ERP_IDBODEGA=1
#  NIT genérico para ventas a consumidor final (por defecto 222222222)
NIT_CONSUMIDOR_FINAL=222222222

# [OPCIONAL] true = simula la sincronización/facturación ERP sin escribir nada (pruebas)
ERP_DRY_RUN=false


# -----------------------------------------------------------------------------
#  Facturación en segundo plano (lib/billingCron.ts)
# -----------------------------------------------------------------------------
# [OPCIONAL] true = la cola de facturación corre dentro del proceso de la app
BILLING_RUN_IN_PROCESS=true
# [OPCIONAL] false = no reconciliar pedidos pendientes al arrancar
BILLING_STARTUP_RECONCILE=true
# [OPCIONAL] Minutos tras los que un trabajo en curso se considera colgado (por defecto 60)
BILLING_STALE_MIN=60
# [OPCIONAL] Cada cuántos minutos se reconcilia la cola (por defecto 15)
BILLING_RECONCILE_INTERVAL_MIN=15


# -----------------------------------------------------------------------------
#  Shopify
# -----------------------------------------------------------------------------
# [OBLIGATORIA] Dominio de la tienda, sin https:// (ej. mi-tienda.myshopify.com)
SHOPIFY_STORE_URL=
# [OBLIGATORIA] Token de la app personalizada (Admin API, empieza por shpat_)
SHOPIFY_ADMIN_ACCESS_TOKEN=
# [OBLIGATORIA] Secreto de firma de webhooks (Shopify → Configuración → Notificaciones)
SHOPIFY_WEBHOOK_SECRET=
# [RECOMENDADA] Secreto compartido para sincronizaciones disparadas por procesos internos
#  (cabecera X-Shopify-Sync-Secret)
SHOPIFY_SYNC_SECRET=
# [OPCIONAL] ID de la ubicación de inventario. Si se omite, se usa la primera de la tienda.
SHOPIFY_LOCATION_ID=

# [OPCIONAL] true = simula la sincronización con Shopify sin llamar al API (pruebas)
SHOPIFY_DRY_RUN=false
# [OPCIONAL] Solo desarrollo: true = ejecuta la sincronización al arrancar
SYNC_RUN_NOW=false


# -----------------------------------------------------------------------------
#  Firebase (clientes de la tienda)
# -----------------------------------------------------------------------------
# [OBLIGATORIA] RUTA al JSON de la cuenta de servicio de Firebase Admin
#  (Consola Firebase → Configuración → Cuentas de servicio → Generar clave privada).
#  Guarda el archivo FUERA de public/ y fuera del repositorio.
FIREBASE_SERVICE_ACCOUNT=./secrets/firebase-service-account.json

# [OBLIGATORIA] Configuración web de Firebase (son públicas por diseño: van al navegador)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# -----------------------------------------------------------------------------
#  WhatsApp Cloud API (Meta)
# -----------------------------------------------------------------------------
# [RECOMENDADA] Necesarias para /api/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# [OPCIONAL] Mensajes permitidos por IP cada 10 minutos (por defecto 10)
WHATSAPP_RL_MAX=10


# -----------------------------------------------------------------------------
#  Agente IA de nombres comerciales (DeepSeek)
# -----------------------------------------------------------------------------
# [RECOMENDADA] Sin ella, los botones "Generar con IA" muestran que no está configurado
DEEPSEEK_API_KEY=
# [OPCIONAL] Modelo y URL del API (compatibles con OpenAI)
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com


# -----------------------------------------------------------------------------
#  Solo scripts de prueba (scripts/*.ts) — no se usan en producción
# -----------------------------------------------------------------------------
# COUNT=
# STRESS_COUNT=
# RETRY_FAILURES=
# RETRY_TEST_PORT=
# CRASH_TEST_PORT=
